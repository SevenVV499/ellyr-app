<Project>
  <!-- Réglages communs aux projets Ellyr (importé explicitement par chaque .csproj, sans effet sur le reste). -->
  <Import Project="$(MSBuildThisFileDirectory)GameDir.user.props" Condition="Exists('$(MSBuildThisFileDirectory)GameDir.user.props')" />

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CS0649;CS0169;CS0414;CS8981;CS1591</NoWarn>
    <DebugType>embedded</DebugType>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Dossier du jeu (celui qui contient GameAssembly.dll et le dossier BepInEx). Défini dans GameDir.user.props. -->
    <GameDir Condition="'$(GameDir)' == ''">C:\CHEMIN\VERS\LE\JEU</GameDir>
  </PropertyGroup>

  <!--
    Où trouver les types du jeu (interop) et les bibliothèques (Il2CppInterop, Harmony…) pour compiler :
    d'abord dans le dossier Ellyr du jeu (une fois déployé), sinon dans le dossier BepInEx.
    Cela permet de supprimer BepInEx tout en continuant à compiler.
  -->
  <PropertyGroup>
    <InteropDir Condition="Exists('$(GameDir)\Ellyr\interop\Assembly-CSharp.dll')">$(GameDir)\Ellyr\interop</InteropDir>
    <InteropDir Condition="'$(InteropDir)' == ''">$(GameDir)\BepInEx\interop</InteropDir>
    <LibDir Condition="Exists('$(GameDir)\Ellyr\lib\Il2CppInterop.Runtime.dll')">$(GameDir)\Ellyr\lib</LibDir>
    <LibDir Condition="'$(LibDir)' == ''">$(GameDir)\BepInEx\core</LibDir>
  </PropertyGroup>

  <!-- Diagnostic : dit clairement où le projet cherche, au lieu de dizaines d'erreurs de types introuvables. -->
  <Target Name="EllyrCheckPaths" BeforeTargets="ResolveAssemblyReferences;CoreCompile">
    <Error Condition="!Exists('$(InteropDir)\Assembly-CSharp.dll')"
           Text="Ellyr : Assembly-CSharp.dll introuvable. GameDir=[$(GameDir)] InteropDir=[$(InteropDir)]. Vérifie GameDir.user.props et que ce dossier contient les DLL du jeu." />
    <Error Condition="!Exists('$(LibDir)\Il2CppInterop.Runtime.dll')"
           Text="Ellyr : Il2CppInterop.Runtime.dll introuvable. GameDir=[$(GameDir)] LibDir=[$(LibDir)]. Vérifie GameDir.user.props et que ce dossier contient les bibliothèques." />
  </Target>
</Project>
